# ─────────────────────────────────────────────────────────────────────────────
# Shopivell — example environment. Copy to .env and fill in what you need.
#
#   cp .env.example .env
#
# Nothing here is a real credential. The defaults below boot the API locally
# with a SQLite file database and no external services.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
# Signing key for access tokens. Generate one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
# Anything you recognise as a local/dev environment.
ENVIRONMENT=development
# TEST_MODE short-circuits payment providers so you can exercise checkout locally.
TEST_MODE=false

# ── Database ────────────────────────────────────────────────────────────────
# true  -> local ./shopivell.db (SQLite, zero setup)
# false -> PostgreSQL via the DB_* variables below (production default)
USE_SQLITE=true
SQL_ECHO=false

# PostgreSQL is required in production: several features use pgvector.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopivell
DB_USERNAME=shopivell
DB_PASSWORD=
DB_SSLMODE=prefer

# ── Cache ───────────────────────────────────────────────────────────────────
# Optional. The app runs without Redis and logs a warning at startup.
REDIS_URL=redis://localhost:6379/0

# ── Model providers ─────────────────────────────────────────────────────────
# Any one provider is enough to bring the agents up.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=

# ── Agent gateway ───────────────────────────────────────────────────────────
# The backend is an HTTP client for the agents. Leave unset to run without them.
# Docs: docs/openclaw-ad-agents.md
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
# Optional: route the six ad roles to Hermes profiles instead.
HERMES_GATEWAY_URL=
HERMES_GATEWAY_TOKEN=
# Optional per-role overrides; defaults live in modules/openclaw/gateway.py
# OPENCLAW_GOAL_MODEL=
# OPENCLAW_PLANNER_MODEL=
# AD_IMAGE_MODEL=
# AD_DEFAULT_DAILY_BUDGET=
# AD_DEFAULT_TOTAL_BUDGET=

# ── WhatsApp Business ───────────────────────────────────────────────────────
WHATSAPP_PERMANENT_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_WEBHOOK_SIGNATURE=true
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

# ── Payments ────────────────────────────────────────────────────────────────
# Paynow — EcoCash / InnBucks / card (Zimbabwe)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL=
PAYNOW_RETURN_URL=
PAYNOW_DEFAULT_EMAIL=support@shopivell.com

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ── Media storage ───────────────────────────────────────────────────────────
# Either S3/MinIO or Cloudinary. Leave both empty to keep uploads on disk.
SPACES_ENDPOINT=
SPACES_REGION=
BUCKET_NAME=
ACCESS_KEY=
SECRET_ACCESS_KEY=
CLOUDINARY_URL=

# ── Email ───────────────────────────────────────────────────────────────────
SMTP_SERVER=
SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
TEST_EMAIL_TO=support@shopivell.com

# ── Seeding (development only) ──────────────────────────────────────────────
SEED_USER_EMAIL=testuser@shopivell.com
SEED_USER_PASSWORD=
SEED_ADMIN_EMAIL=admin@shopivell.com
SEED_ADMIN_PASSWORD=
